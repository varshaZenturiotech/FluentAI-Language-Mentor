# ==============================================================================
# FluentAI AI Gateway Configuration Variables Blueprint
# Copy this file to '.env' and fill in the values prior to starting the service.
# ==============================================================================

# Port on which the FastAPI application will run (default is 5001)
PORT=5001

# The active LLM provider (Choose from: openai, gemini, ollama, claude)
LLM_PROVIDER=openai

# Shared secret key used to authenticate requests from Node.js backend.
# Every request must have 'X-Internal-Key' header matching this value.
INTERNAL_API_KEY=your_shared_internal_secret_key_here

# API key for OpenAI (Required if LLM_PROVIDER=openai)
GROQ_API_KEY=your_openai_api_key_here

# Groq model to use for completions (e.g. llama-3.1-70b-versatile)
GROQ_MODEL=llama-3.1-70b-versatile

# Timeout in seconds for LLM provider API requests
REQUEST_TIMEOUT=30.0

# Logging severity level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

MAX_AUDIO_UPLOAD_SIZE_MB=25
GROQ_STT_MODEL=whisper-large-v3
